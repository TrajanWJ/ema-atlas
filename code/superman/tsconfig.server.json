{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": [
    "src/types.ts",
    "src/config.ts",
    "src/logger.ts",
    "src/server.ts",
    "src/autonomous-engine.ts",
    "src/intent-engine.ts",
    "src/gap-engine.ts",
    "src/planner.ts",
    "src/intent-graph.ts",
    "src/zoom-engine.ts",
    "src/auto-intent-generator.ts",
    "src/flow-generator.ts",
    "src/flow-engine.ts",
    "src/focus-engine.ts",
    "src/project-manager.ts",
    "src/working-memory.ts",
    "src/experience-store.ts",
    "src/product-vision.ts",
    "src/build-loop.ts",
    "src/self-evolve.ts",
    "src/parser/**/*.ts",
    "src/semantic/**/*.ts",
    "src/structural/**/*.ts",
    "src/graph/**/*.ts",
    "src/query/**/*.ts",
    "src/simulation/**/*.ts",
    "src/modification/**/*.ts",
    "src/execution/**/*.ts",
    "src/impact/**/*.ts",
    "src/context/**/*.ts",
    "src/sync/**/*.ts",
    "src/routes/**/*.ts",
    "src/ai/**/*.ts",
    "src/suggestions/**/*.ts",
    "src/retrieval/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
