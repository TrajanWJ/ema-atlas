# ─── Discord Bot ─────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-server-id

# ─── Access Control ─────────────────────────────────────
# Set to true to allow every user in DISCORD_GUILD_ID to use the bot
ALLOW_ALL_USERS=false
# Comma-separated Discord user IDs allowed to use commands when allow-all is false
ALLOWED_USERS=your-discord-user-id
# Bot requests Message Content intent by default; set to false only if the portal toggle is disabled
ENABLE_MESSAGE_CONTENT=true
# Allow bot-authored messages only in dedicated bot lanes (channel names starting with prefixes below)
ALLOW_BOT_MESSAGES=false
# Optional explicit bot user allowlist; leave empty to allow any bot in bot lanes when enabled
ALLOWED_BOT_USERS=
# Comma-separated channel-name prefixes treated as bot-to-bot lanes
BOT_CHANNEL_PREFIXES=bot-,agent-

# ─── Server ─────────────────────────────────────────────
SERVER_PORT=3001
DATA_DIR=~/.claudeforge

# ─── Hermes Backend ─────────────────────────────────────
HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_API_KEY=
HERMES_MODEL=gpt-5.4

# ─── Web UI ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# ─── Path Security ──────────────────────────────────────
# Comma-separated allowed base paths (empty = allow all)
ALLOWED_PATHS=
DEFAULT_DIRECTORY=/home/trajan/Desktop/Coding
