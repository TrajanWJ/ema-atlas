{
  "name": "wiki-engine",
  "version": "0.1.0",
  "description": "Personal wiki engine — Markdown + YAML frontmatter + SQLite + REST API",
  "main": "dist/engine/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/engine/server.js",
    "dev": "ts-node engine/server.ts",
    "migrate:dry-run": "ts-node migrate/migrate.ts --dry-run",
    "migrate:run": "ts-node migrate/migrate.ts --migrate",
    "migrate:verify": "ts-node migrate/migrate.ts --verify",
    "reindex": "ts-node engine/indexer.ts --reindex",
    "embed-all": "node dist/scripts/embed-all.js",
    "embed-all:force": "node dist/scripts/embed-all.js --force"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
