# ─── Discord Bot ─────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-server-id

# ─── Access Control ─────────────────────────────────────
# Comma-separated Discord user IDs allowed to use commands
ALLOWED_USERS=your-discord-user-id

# ─── Server ─────────────────────────────────────────────
SERVER_PORT=3001
DATA_DIR=/home/trajan/.claudeforge

# ─── Hermes Backend (optional provider) ─────────────────
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=gpt-5.4

# ─── Web UI ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# ─── Path Security ──────────────────────────────────────
# Comma-separated allowed base paths (empty = allow all)
ALLOWED_PATHS=
DEFAULT_DIRECTORY=/home/trajan/Desktop/Coding
