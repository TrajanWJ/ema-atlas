{
  "expo": {
    "name": "Autharis",
    "slug": "autharis-mobile",
    "scheme": "autharis",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autharis.mobile"
    },
    "android": {
      "package": "com.autharis.mobile"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
