{
  "name": "ema-runtime",
  "version": "0.0.6-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "cli": "bash scripts/run-cli.sh",
    "build:cli": "pnpm --filter @ema/cli build",
    "workspace:e2e": "node tooling/workspace-e2e.mjs",
    "harness:smoke": "node tooling/harness-glue-cli-smoke.mjs",
    "orchestrator:doctor": "node tooling/orchestrator-doctor.mjs",
    "runtime:report": "node tooling/runtime-process-report.mjs",
    "release:reinstall:dry": "node tooling/reinstall-ema-0.0.6.mjs --dry-run",
    "release:reinstall:preflight": "node tooling/reinstall-ema-0.0.6.mjs --preflight-only",
    "release:reinstall": "node tooling/reinstall-ema-0.0.6.mjs --delete-target",
    "e2e:functional": "node tooling/ema-functional-e2e.mjs",
    "cockpit:perf": "node tooling/cockpit-performance-smoke.mjs",
    "dev:daemon": "bash scripts/dev-daemon.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:desktop": "bash scripts/dev-desktop.sh",
    "build:web-static": "bash scripts/build-web-static-out.sh",
    "check:contracts": "bash scripts/contract-check.sh",
    "p2p:update:pack": "node tooling/p2p-dev-update.mjs pack",
    "p2p:update:serve": "node tooling/p2p-dev-update.mjs serve --pack",
    "p2p:update:check": "node tooling/p2p-dev-update.mjs check",
    "p2p:update:apply": "node tooling/p2p-dev-update.mjs apply"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "ws": "^8.20.0"
  }
}
