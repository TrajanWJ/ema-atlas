{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMA",
  "version": "0.0.5",
  "identifier": "org.ema.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ema/web dev",
    "beforeBuildCommand": "pnpm --filter @ema/web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "EMA",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:49555; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
