{
  "name": "code-intelligence-engine",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered code intelligence engine with semantic editor",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:backend": "tsx watch src/server.ts",
    "dev:all": "concurrently -n frontend,backend -c blue,green \"npm run dev\" \"npm run dev:backend\"",
    "build": "next build",
    "build:backend": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:backend",
    "start": "next start --port 3001",
    "start:backend": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@ast-grep/napi": "^0.33.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@monaco-editor/react": "^4.6.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.183.1",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "glob": "^11.0.0",
    "minisearch": "^7.2.0",
    "next": "^15.1.0",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.2",
    "uuid": "^11.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
